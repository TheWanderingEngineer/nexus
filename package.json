{
  "name": "nexus-dashboard",
  "version": "0.4.0",
  "description": "Retro-pixel homelab dashboard, Docker manager and app store for a single Linux host",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "check": "node scripts/selfcheck.js",
    "vendor": "node scripts/vendor-xterm.js",
    "store-check": "node scripts/store-check.js",
    "gui:verify": "node scripts/gui-backup.js verify",
    "gui:restore": "node scripts/gui-backup.js restore",
    "gui:check": "node scripts/gui-check.js",
    "agent:check": "node scripts/agent-check.js",
    "proxy:check": "node scripts/proxy-check.js"
  },
  "dependencies": {
    "dockerode": "^4.0.2",
    "express": "^4.21.2",
    "systeminformation": "^5.23.5",
    "ws": "^8.18.0",
    "yaml": "^2.9.0"
  },
  "optionalDependencies": {
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0"
  }
}
